---
import SocialLinks from './SocialLinks.astro';
import { personalSocials } from '../data/social';
const year = new Date().getFullYear();
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/#projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name display">Matt McCloskey</p>
      <p class="site-footer__tag">
        Product &amp; design leader — Austin, TX. Building at the intersection of
        design, code, and AI.
      </p>
      <div class="site-footer__socials">
        <SocialLinks links={personalSocials} size="md" label="Matt McCloskey on social" />
      </div>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      {
        nav.map((l) => (
          <a
            href={l.href}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a href="mailto:mattmccloskey@gmail.com">Email</a>
    </nav>
  </div>
  <div class="container site-footer__base">
    <span>© {year} Matt McCloskey</span>
    <span>Austin, Texas</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #c7d0d9;
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .site-footer__brand {
    max-width: 30ch;
  }
  .site-footer__name {
    color: #fff;
    font-size: 1.6rem;
    letter-spacing: 0.06em;
    margin-bottom: 0.6rem;
  }
  .site-footer__tag {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #97a4b0;
  }
  .site-footer__socials {
    margin-top: 1.25rem;
    margin-left: -8px; /* optical align icons with text */
    --social-fg: #97a4b0;
    --social-hover: #fff;
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 3rem;
  }
  .site-footer__nav a {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    font-weight: 500;
    color: #c7d0d9;
    transition: color 0.2s ease;
  }
  .site-footer__nav a:hover {
    color: var(--blue);
  }
  .site-footer__base {
    display: flex;
    justify-content: space-between;
    padding-top: 1.4rem;
    font-size: 0.82rem;
    color: #6f7d8a;
  }
  @media (max-width: 560px) {
    .site-footer__base {
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>
