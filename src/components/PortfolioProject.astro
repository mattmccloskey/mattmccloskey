---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface PortfolioImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  index: number;
  name: string;
  descriptor: string;
  role: string;
  brief: string;
  accent: string;
  ink: string;
  theme?: 'light' | 'dark';
  images: PortfolioImage[];
}

const {
  index,
  name,
  descriptor,
  role,
  brief,
  accent,
  ink,
  theme = 'light',
  images,
} = Astro.props;

const num = String(index).padStart(2, '0');
---

<section
  class:list={['proj', `proj--${theme}`]}
  style={`--accent:${accent}; --accent-ink:${ink};`}
  aria-labelledby={`proj-${num}`}
>
  <div class="proj__intro">
    <div class="container proj__intro-grid">
      <div class="proj__id" data-reveal>
        <span class="proj__num display">{num}</span>
        <span class="proj__client-label">Client</span>
        <h2 class="proj__name" id={`proj-${num}`}>{name}</h2>
        <p class="proj__descriptor">{descriptor}</p>
      </div>

      <div class="proj__meta">
        <div class="proj__meta-block" data-reveal style="--reveal-delay:90ms">
          <span class="proj__meta-label">Role</span>
          <p class="proj__role">{role}</p>
        </div>
        <div class="proj__meta-block" data-reveal style="--reveal-delay:160ms">
          <span class="proj__meta-label">Brief</span>
          <p class="proj__brief">{brief}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="container proj__gallery">
    {
      images.map((img, i) => (
        <figure class="proj__figure" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
          <div class="proj__figure-media">
            <Image
              src={img.src}
              alt={img.alt}
              widths={[560, 900, 1400]}
              sizes="(max-width: 1000px) 92vw, 960px"
              loading="lazy"
            />
          </div>
          {img.caption && <figcaption class="proj__caption">{img.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</section>

<style>
  .proj {
    --intro-bg: var(--accent);
  }
  /* Intro band */
  .proj__intro {
    background: var(--accent);
    color: var(--accent-ink);
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
  .proj--light .proj__intro {
    /* light-themed intros get a subtle tint instead of full saturation */
    background: color-mix(in srgb, var(--accent) 10%, #fff);
    color: var(--ink);
  }
  .proj__intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  .proj__id {
    position: relative;
    min-width: 0;
  }
  .proj__meta {
    min-width: 0;
  }
  .proj__num {
    display: block;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    opacity: 0.32;
    letter-spacing: 0.04em;
    margin-bottom: 0.6rem;
  }
  .proj__client-label,
  .proj__meta-label {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.65;
    margin-bottom: 0.5rem;
  }
  .proj__name {
    font-size: clamp(2.1rem, 6vw, 4.2rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 0.98;
    overflow-wrap: break-word;
  }
  .proj--light .proj__name {
    color: color-mix(in srgb, var(--accent) 78%, var(--ink));
  }
  .proj__descriptor {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    letter-spacing: 0.02em;
    max-width: 26ch;
    opacity: 0.92;
  }
  .proj__meta {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: clamp(0.5rem, 3vw, 3.5rem);
  }
  .proj__role,
  .proj__brief {
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 46ch;
  }
  .proj__brief {
    opacity: 0.92;
  }

  /* Gallery */
  .proj__gallery {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .proj__figure {
    margin: 0;
  }
  .proj__figure-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-tint);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .proj__figure-media :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transform: scale(1.02);
    transition: transform 1.1s var(--ease);
  }
  [data-reveal].is-in .proj__figure-media :global(img),
  .proj__figure.is-in .proj__figure-media :global(img) {
    transform: scale(1);
  }
  .proj__caption {
    margin-top: 0.9rem;
    font-size: 0.88rem;
    color: var(--ink-500);
    text-align: center;
  }

  @media (max-width: 820px) {
    .proj__intro-grid {
      grid-template-columns: 1fr;
    }
    .proj__meta {
      padding-top: 0;
    }
  }
</style>
