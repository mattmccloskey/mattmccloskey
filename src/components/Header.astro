---
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/#projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
];
---

<header class="site-header" data-header data-variant={variant}>
  <div class="site-header__inner container">
    <a class="wordmark" href="/" aria-label="Matt McCloskey — home">
      <span class="wordmark__mono">MM</span>
      <span class="wordmark__name">Matt McCloskey</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            class="nav__link"
            href={l.href}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a class="nav__cta" href="mailto:hello@mattmccloskey.com">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, #ffffff 78%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, #ffffff 92%, transparent);
    border-bottom-color: var(--line);
    box-shadow: 0 1px 0 rgba(22, 32, 42, 0.02);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    text-transform: uppercase;
  }
  .wordmark__mono {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--blue);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-sm);
  }
  .wordmark__name {
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: 0.14em;
    color: var(--ink);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2rem);
  }
  .nav__link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.86rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-700);
    transition: color 0.2s ease;
  }
  .nav__link:hover {
    color: var(--blue-600);
  }
  .nav__cta {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.6em 1.1em;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    transition:
      transform 0.2s var(--ease),
      background 0.2s ease;
  }
  .nav__cta:hover {
    transform: translateY(-1px);
    background: var(--blue);
  }

  @media (max-width: 720px) {
    .wordmark__name {
      display: none;
    }
    .nav__link {
      display: none;
    }
    .site-header__inner {
      height: 60px;
    }
  }
</style>
