---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { projects } from '../data/projects';
import { moves, engagements } from '../data/services';
import { personalSocials } from '../data/social';
import { booking, bookingPath, bookingNamespace, bookingConfig, email } from '../data/site';
import headshot from '../assets/headshot.jpeg';

const mailto = `mailto:${email}?subject=Shipping%20my%20idea`;
const bookLabel = 'Book a 15-min call';
// Opens the Cal.com popup; href is the graceful fallback if the embed script fails.
const calAttrs = {
  href: booking,
  'data-cal-namespace': bookingNamespace,
  'data-cal-link': bookingPath,
  'data-cal-config': bookingConfig,
};

const stats = [
  { value: '20+', label: 'Years shipping software' },
  { value: '5', label: 'SaaS products founded' },
  { value: '12M', label: 'Users reached' },
  { value: '100s', label: 'Products delivered' },
];

const experience = [
  {
    role: 'VP of Product',
    org: 'Hypergiant',
    period: '2023 – 2024',
    note: 'Shipped AI-powered geospatial decision tools for NORAD / NORTHCOM and critical infrastructure — where “it mostly works” was never an option.',
  },
  {
    role: 'VP of Product Design',
    org: 'Rex',
    period: '2021 – 2023',
    note: 'Product & design across 10 startups at once — taking early ideas from concept to launched product, fast.',
  },
  {
    role: 'Technology / Design Director',
    org: 'Fjord · Accenture',
    period: '2018 – 2021',
    note: 'Directed a $6M F-35 data program and California’s ACA enrollment platform — 12M residents depending on it working.',
  },
  {
    role: 'Founder',
    org: 'Osmek',
    period: '2006 – 2018',
    note: 'Built and ran the world’s first SaaS headless CMS end-to-end, to 2,000+ accounts.',
  },
];

const clients = [
  'NORAD / NORTHCOM',
  'Lockheed Martin',
  'USPS',
  'Shell',
  'State of California',
  'IBM',
  'Cisco',
];
---

<Base
  title="Matt McCloskey — Ship your idea to production"
  description="You built your product to 80–90% with AI. I’m an engineer, designer, and product leader who helps founders stabilize, polish, and ship it into production."
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy" data-reveal>
        <p class="eyebrow">For builders who got it to 90%</p>
        <h1 class="hero__title">
          Get your idea<br /><span class="hero__accent">over the line.</span>
        </h1>
        <p class="hero__lede">
          You used AI to build your dream to 80–90%. The last stretch — nailing the
          MVP, sharpening the experience, and the auth, data, and deploy — is where
          momentum dies. I’m an engineer, designer, and product leader with 20+ years
          shipping software that couldn’t fail. I bring a clear point of view to your
          idea, stabilize what you’ve built, and get it into production.
        </p>
        <div class="hero__actions">
          <a class="btn btn--blue" {...calAttrs}>
            {bookLabel}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </a>
          <a class="btn btn--ghost" href="#services">See how I help</a>
        </div>
        <p class="hero__meta">
          Austin, TX · Prefer email? <a href={mailto}>{email}</a>
        </p>
      </div>

      <div class="hero__portrait" data-reveal style="--reveal-delay:120ms">
        <div class="hero__portrait-frame">
          <Image
            src={headshot}
            alt="Matt McCloskey"
            width={620}
            widths={[360, 480, 620]}
            sizes="(max-width: 900px) 60vw, 420px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero__portrait-blob" aria-hidden="true"></div>
      </div>
    </div>

    <!-- stats strip -->
    <div class="container">
      <ul class="stats" data-reveal>
        {
          stats.map((s) => (
            <li class="stats__item">
              <span class="stats__value display">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== SERVICE: the last 20% ===================== -->
  <section class="section services" id="services">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">The Service</p>
        <h2 class="section-title">I help you ship the last 20%</h2>
        <p class="section-sub">
          AI can get you a working prototype. Turning it into a real product — one
          that’s focused, secure, stable, and something people trust — is a different
          job. That’s the part I do.
        </p>
      </header>

      <div class="moves">
        {
          moves.map((m, i) => (
            <article class="move" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="move__step display">{m.step}</span>
              <h3 class="move__title">{m.title}</h3>
              <p class="move__blurb">{m.blurb}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== WAYS TO WORK TOGETHER ===================== -->
  <section class="section engagements" id="work-with-me">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Ways to Work Together</p>
        <h2 class="section-title">Pick the level of help you need</h2>
      </header>

      <div class="eng-grid">
        {
          engagements.map((e, i) => (
            <article
              class:list={['eng', { 'eng--featured': e.featured }]}
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              {e.featured && <span class="eng__tag">Most hands-on</span>}
              <span class="eng__for">{e.bestFor}</span>
              <h3 class="eng__name">{e.name}</h3>
              <p class="eng__blurb">{e.blurb}</p>
            </article>
          ))
        }
      </div>

      <div class="eng__cta" data-reveal>
        <a class="btn btn--blue" {...calAttrs}>{bookLabel}</a>
        <a class="btn btn--ghost" href="/portfolio">See my work</a>
      </div>
    </div>
  </section>

  <!-- ===================== WHY ME (track record) ===================== -->
  <section class="section work" id="why-me">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Why Me</p>
        <h2 class="section-title">Two decades shipping software that couldn’t fail</h2>
        <p class="section-sub">
          Long before AI could scaffold an app in an afternoon, I spent 20+ years
          getting high-stakes software into production — for defense, healthcare, and
          critical infrastructure. That hard-won rigor is what I bring to your project.
        </p>
      </header>

      <ol class="timeline">
        {
          experience.map((e, i) => (
            <li class="tl" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div class="tl__head">
                <h3 class="tl__role">{e.role}</h3>
                <span class="tl__org">{e.org}</span>
                <span class="tl__period">{e.period}</span>
              </div>
              <p class="tl__note">{e.note}</p>
            </li>
          ))
        }
      </ol>

      <div class="work__cta" data-reveal>
        <a class="btn btn--blue" href="/portfolio">
          Explore the full portfolio
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </a>
        <a class="btn btn--ghost" href="/resume">Read the résumé</a>
      </div>

      <div class="clients" data-reveal>
        <span class="clients__label">Shipped for</span>
        <ul class="clients__list">
          {clients.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== PROJECTS (I ship my own) ===================== -->
  <section class="section projects" id="projects">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">I Ship My Own, Too</p>
        <h2 class="section-title">I don’t just advise — I build</h2>
        <p class="section-sub">
          I’m actively founding and shipping my own products, so I’m in the same
          trenches you are — not commentating from the sidelines.
        </p>
      </header>

      <div class="projects__grid">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section class="section contact">
    <div class="container contact__inner" data-reveal>
      <p class="eyebrow" style="color: var(--blue)">Let’s talk</p>
      <h2 class="contact__title">Stuck at 90%?</h2>
      <p class="contact__sub">
        If you’ve got an idea that’s almost there and needs a seasoned hand to push it
        into production, grab a quick 15-minute call — no pitch, just a conversation
        about what you’re building.
      </p>
      <div class="contact__actions">
        <a class="btn btn--on-dark" {...calAttrs}>{bookLabel}</a>
        <a class="btn btn--ghost btn--ghost-dark" href={mailto}>Email me instead</a>
      </div>
      <div class="contact__socials">
        <SocialLinks links={personalSocials} size="md" label="Matt McCloskey on social" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 82% 8%, rgba(73, 158, 215, 0.14), transparent 60%),
      radial-gradient(50% 50% at 0% 100%, rgba(73, 158, 215, 0.08), transparent 65%);
    z-index: -1;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .hero__copy {
    min-width: 0;
  }
  .hero__title {
    font-size: clamp(2.7rem, 8vw, 5.6rem);
    overflow-wrap: break-word;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-weight: 700;
    line-height: 0.98;
    margin-block: 1rem 1.4rem;
    color: var(--ink);
  }
  .hero__accent {
    color: var(--blue);
  }
  .hero__lede {
    max-width: 48ch;
    font-size: 1.08rem;
    line-height: 1.62;
    color: var(--ink-700);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .hero__meta {
    margin-top: 1.4rem;
    font-size: 0.92rem;
    color: var(--ink-500);
  }
  .hero__meta a {
    color: var(--blue-600);
    font-weight: 500;
  }

  .hero__portrait {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
    min-width: 0;
  }
  .hero__portrait-frame {
    position: relative;
    z-index: 2;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 6px solid #fff;
    box-shadow: var(--shadow-lg);
  }
  .hero__portrait-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__portrait-blob {
    position: absolute;
    z-index: 1;
    inset: -8% -10% auto auto;
    width: 78%;
    aspect-ratio: 1;
    right: -6%;
    top: -6%;
    background: var(--blue);
    border-radius: 46% 54% 58% 42% / 52% 44% 56% 48%;
    opacity: 0.9;
  }

  /* ---------- STATS ---------- */
  .stats {
    list-style: none;
    margin: clamp(1.5rem, 4vw, 3rem) 0 0;
    padding: clamp(1.4rem, 3vw, 2rem) 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stats__value {
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--blue);
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .stats__label {
    font-size: 0.86rem;
    color: var(--ink-500);
    line-height: 1.3;
  }

  /* ---------- SECTION HEADINGS ---------- */
  .section-head {
    max-width: 60ch;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .section-title {
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    text-transform: uppercase;
    letter-spacing: 0.015em;
    margin-block: 0.7rem 0.9rem;
    color: var(--ink);
  }
  .section-sub {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-700);
  }

  /* ---------- SERVICE MOVES ---------- */
  .services {
    background: var(--bg-tint);
  }
  .moves {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .move {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.1rem);
  }
  .move__step {
    display: block;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--blue);
    opacity: 0.4;
    margin-bottom: 0.7rem;
  }
  .move__title {
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin-bottom: 0.55rem;
  }
  .move__blurb {
    color: var(--ink-700);
    line-height: 1.55;
    font-size: 0.98rem;
  }

  /* ---------- ENGAGEMENTS ---------- */
  .eng-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: stretch;
  }
  .eng {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .eng--featured {
    border-color: var(--blue);
    box-shadow: 0 0 0 1px var(--blue), var(--shadow-md);
  }
  .eng__tag {
    position: absolute;
    top: -0.75rem;
    left: clamp(1.5rem, 3vw, 2.1rem);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.66rem;
    font-weight: 600;
    padding: 0.3em 0.8em;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
  }
  .eng__for {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--blue-600);
  }
  .eng__name {
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1.05;
  }
  .eng__blurb {
    color: var(--ink-700);
    line-height: 1.55;
    font-size: 0.96rem;
  }
  .eng__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: clamp(1.8rem, 3vw, 2.5rem);
  }

  /* ---------- TIMELINE (why me) ---------- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .tl {
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 0.4rem 2.5rem;
    align-items: baseline;
  }
  .tl:last-child {
    border-bottom: 1px solid var(--line);
  }
  .tl__head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .tl__role {
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .tl__org {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--blue-600);
  }
  .tl__period {
    font-size: 0.82rem;
    color: var(--ink-300);
  }
  .tl__note {
    color: var(--ink-700);
    line-height: 1.6;
  }

  .work__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }

  .clients {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .clients__label {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.72rem;
    color: var(--ink-300);
    margin-bottom: 1rem;
  }
  .clients__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 2rem;
  }
  .clients__list li {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    color: var(--ink-300);
    transition: color 0.2s ease;
  }
  .clients__list li:hover {
    color: var(--ink);
  }

  /* ---------- PROJECTS ---------- */
  .projects {
    background: var(--bg-tint);
  }
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: stretch;
  }
  /* Feature the two flagship products as wide cards (7 items → clean 3×3) */
  .projects__grid > :global(.pcard:nth-child(1)),
  .projects__grid > :global(.pcard:nth-child(4)) {
    grid-column: span 2;
  }

  /* ---------- CONTACT ---------- */
  .contact {
    background: var(--ink);
    color: #fff;
    text-align: center;
  }
  .contact__inner {
    max-width: 60ch;
  }
  .contact__title {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-block: 0.8rem 1rem;
  }
  .contact__sub {
    font-size: 1.08rem;
    line-height: 1.6;
    color: #a9b4bf;
    margin-inline: auto;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .btn--ghost-dark {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn--ghost-dark:hover {
    border-color: #fff;
  }
  .contact__socials {
    display: flex;
    justify-content: center;
    margin-top: 1.75rem;
    --social-fg: #8b98a5;
    --social-hover: #fff;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero__portrait {
      grid-row: 1;
      width: min(62%, 320px);
      justify-self: start;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }
    .moves {
      grid-template-columns: repeat(2, 1fr);
    }
    .eng-grid {
      grid-template-columns: 1fr;
    }
    .tl {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .projects__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .moves,
    .projects__grid {
      grid-template-columns: 1fr;
    }
    .projects__grid > :global(.pcard:nth-child(1)),
    .projects__grid > :global(.pcard:nth-child(4)) {
      grid-column: auto;
    }
  }
</style>
