---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { summary, highlights, skills, experience, ventures } from '../data/resume';
import { downloads } from '../data/site';
import headshot from '../assets/headshot.jpeg';
---

<Base
  title="Résumé — Matt McCloskey"
  description="Résumé of Matt McCloskey — product & design leader with 20+ years shipping digital products across defense, healthcare, and critical infrastructure."
>
  <!-- ===================== HERO ===================== -->
  <section class="cv-hero">
    <div class="cv-hero__bg" aria-hidden="true"></div>
    <div class="container cv-hero__inner">
      <div class="cv-hero__copy" data-reveal>
        <p class="eyebrow">Résumé</p>
        <h1 class="cv-hero__name">Matt McCloskey</h1>
        <p class="cv-hero__role">Product &amp; Design Leader</p>
        <ul class="cv-hero__meta">
          <li>Austin, TX</li>
          <li><a href="mailto:mattmccloskey@gmail.com">mattmccloskey@gmail.com</a></li>
          <li><a href="https://www.linkedin.com/in/mamccloskey/" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
        <div class="cv-hero__actions">
          <a class="btn btn--blue" href={downloads.resume} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path
                d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            Download PDF
          </a>
          <a class="btn btn--ghost" href="/portfolio">View portfolio</a>
        </div>
      </div>
      <div class="cv-hero__portrait" data-reveal style="--reveal-delay:100ms">
        <Image src={headshot} alt="Matt McCloskey" width={260} widths={[180, 260]} sizes="150px" loading="eager" />
      </div>
    </div>
  </section>

  <!-- ===================== SUMMARY ===================== -->
  <section class="section cv-summary">
    <div class="container">
      <p class="cv-summary__text" data-reveal>{summary}</p>
    </div>
  </section>

  <!-- ===================== HIGHLIGHTS ===================== -->
  <section class="cv-block">
    <div class="container">
      <h2 class="cv-h2" data-reveal>Professional Highlights</h2>
      <ul class="cv-highlights">
        {
          highlights.map((h, i) => (
            <li class="cv-highlight" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <span class="cv-highlight__mark" aria-hidden="true" />
              <span>{h}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== EXPERIENCE + SKILLS ===================== -->
  <section class="cv-block">
    <div class="container cv-cols">
      <div class="cv-main">
        <h2 class="cv-h2" data-reveal>Experience</h2>
        <ol class="cv-exp">
          {
            experience.map((e, i) => (
              <li class="cv-role" data-reveal style={`--reveal-delay:${(i % 2) * 60}ms`}>
                <div class="cv-role__head">
                  <h3 class="cv-role__title">{e.role}</h3>
                  <span class="cv-role__period">{e.period}</span>
                </div>
                <p class="cv-role__org">{e.org}</p>
                {e.blurb && <p class="cv-role__blurb">{e.blurb}</p>}
                <ul class="cv-role__bullets">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>

      <aside class="cv-aside">
        <div class="cv-skills" data-reveal>
          <h2 class="cv-h2 cv-h2--sm">Technical Proficiencies</h2>
          {
            skills.map((g) => (
              <div class="cv-skillgroup">
                <h3 class="cv-skillgroup__label">{g.label}</h3>
                <ul class="cv-chips">
                  {g.items.map((it) => (
                    <li class="cv-chip">{it}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== VENTURES ===================== -->
  <section class="cv-block cv-block--tint">
    <div class="container">
      <h2 class="cv-h2" data-reveal>The Entrepreneur</h2>
      <p class="cv-block__sub" data-reveal>Things I’ve founded and built along the way.</p>
      <div class="cv-ventures">
        {
          ventures.map((v, i) => (
            <article class="cv-venture" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
              <div class="cv-venture__head">
                <h3 class="cv-venture__name">{v.name}</h3>
                <span class="cv-venture__period">{v.period}</span>
              </div>
              <p class="cv-venture__role">{v.role}</p>
              <p class="cv-venture__blurb">{v.blurb}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== OUTRO ===================== -->
  <section class="cv-outro">
    <div class="container cv-outro__inner" data-reveal>
      <h2 class="cv-outro__title">Want the printable version?</h2>
      <div class="cv-outro__actions">
        <a class="btn btn--blue" href={downloads.resume} target="_blank" rel="noopener">Download résumé (PDF)</a>
        <a class="btn btn--on-dark" href="mailto:mattmccloskey@gmail.com">Get in touch</a>
        <a class="btn btn--ghost btn--ghost-on-dark" href="/">Back home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .cv-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .cv-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(50% 60% at 88% 0%, rgba(73, 158, 215, 0.14), transparent 62%);
    z-index: -1;
  }
  .cv-hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }
  .cv-hero__copy {
    min-width: 0;
  }
  .cv-hero__name {
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 0.98;
    margin-top: 0.7rem;
  }
  .cv-hero__role {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    color: var(--blue-600);
    margin-top: 0.6rem;
  }
  .cv-hero__meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    padding: 0;
    margin: 1.2rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-500);
  }
  .cv-hero__meta a {
    color: var(--blue-600);
    font-weight: 500;
  }
  .cv-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.8rem;
  }
  .cv-hero__portrait {
    flex: 0 0 auto;
  }
  .cv-hero__portrait :global(img) {
    width: clamp(96px, 16vw, 150px);
    height: clamp(96px, 16vw, 150px);
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid #fff;
    box-shadow: var(--shadow-lg);
  }

  /* ---------- SUMMARY ---------- */
  .cv-summary {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
  }
  .cv-summary__text {
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    line-height: 1.5;
    font-weight: 400;
    color: var(--ink);
    max-width: 62ch;
  }

  /* ---------- BLOCKS ---------- */
  .cv-block {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .cv-block--tint {
    background: var(--bg-tint);
  }
  .cv-h2 {
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 1.6rem;
  }
  .cv-h2--sm {
    font-size: clamp(1.2rem, 2.6vw, 1.5rem);
  }
  .cv-block__sub {
    margin-top: -0.9rem;
    margin-bottom: 2rem;
    color: var(--ink-500);
  }

  /* ---------- HIGHLIGHTS ---------- */
  .cv-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    max-width: 90ch;
  }
  .cv-highlight {
    display: flex;
    gap: 0.85rem;
    align-items: baseline;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-700);
  }
  .cv-highlight__mark {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--blue);
    transform: translateY(-1px);
  }

  /* ---------- COLUMNS ---------- */
  .cv-cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .cv-main {
    min-width: 0;
  }

  /* ---------- EXPERIENCE ---------- */
  .cv-exp {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cv-role {
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .cv-role:first-child {
    padding-top: 0;
    border-top: none;
  }
  .cv-role__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }
  .cv-role__title {
    font-size: 1.4rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .cv-role__period {
    font-size: 0.82rem;
    color: var(--ink-300);
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .cv-role__org {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.92rem;
    color: var(--blue-600);
    margin-top: 0.2rem;
  }
  .cv-role__blurb {
    margin-top: 0.7rem;
    color: var(--ink-700);
    font-style: italic;
  }
  .cv-role__bullets {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .cv-role__bullets li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--ink-700);
    line-height: 1.55;
  }
  .cv-role__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--blue) 55%, var(--line));
  }

  /* ---------- SKILLS ---------- */
  .cv-aside {
    position: sticky;
    top: 90px;
  }
  .cv-skills {
    background: var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .cv-skillgroup + .cv-skillgroup {
    margin-top: 1.4rem;
  }
  .cv-skillgroup__label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: var(--ink-500);
    margin-bottom: 0.7rem;
  }
  .cv-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .cv-chip {
    font-size: 0.82rem;
    padding: 0.35em 0.75em;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--ink-700);
  }

  /* ---------- VENTURES ---------- */
  .cv-ventures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem);
  }
  .cv-venture {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
  }
  .cv-venture__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .cv-venture__name {
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .cv-venture__period {
    font-size: 0.75rem;
    color: var(--ink-300);
    font-family: var(--font-display);
    white-space: nowrap;
  }
  .cv-venture__role {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--blue-600);
    margin-top: 0.25rem;
  }
  .cv-venture__blurb {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-700);
  }

  /* ---------- OUTRO ---------- */
  .cv-outro {
    background: var(--ink);
    color: #fff;
    text-align: center;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .cv-outro__title {
    font-size: clamp(1.9rem, 5vw, 3rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 1.4rem;
  }
  .cv-outro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
  }
  .btn--ghost-on-dark {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .btn--ghost-on-dark:hover {
    border-color: #fff;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 820px) {
    .cv-cols {
      grid-template-columns: 1fr;
    }
    .cv-aside {
      position: static;
    }
    .cv-ventures {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .cv-hero__inner {
      flex-direction: row-reverse;
      align-items: flex-start;
    }
    .cv-hero__portrait :global(img) {
      width: 84px;
      height: 84px;
    }
    .cv-ventures {
      grid-template-columns: 1fr;
    }
  }
</style>
